# Copy this file to .env.local and fill in real values.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/enterprise_supply_chain

# Qdrant vector database for similar-product search (steps 16-18).
# These are the defaults, so they can be left out of .env.local.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=products
